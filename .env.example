# SkyTrack environment overrides — copy to .env and fill in values.
# Never commit .env or any credentials.

# Override default server
SKYTRACK_NETWORK__DEFAULT_SERVER=dev.skyhigh.local

# Swift bridge
SKYTRACK_NETWORK__BRIDGE_HOST=127.0.0.1
SKYTRACK_NETWORK__BRIDGE_PORT=51001

# Mumble / voice
SKYTRACK_VOICE__MUMBLE_HOST=voice.skyhigh.local
SKYTRACK_VOICE__MUMBLE_PORT=64738
